{
  "name": "fastbox-electron",
  "version": "0.1.0",
  "description": "FastBox UI 层 — 跨平台快捷启动工具",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-runtime.ps1",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": "FastBox",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "extends": "./electron-builder.yml"
  }
}
